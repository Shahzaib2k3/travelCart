generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BookingType {
  PAYMENT_PLAN
  PAYMENT_AWAITING
  FULL_PAYMENT
  DATE_CHANGE
}

enum JourneyType {
  ONE_WAY
  RETURN
  MULTI_CITY
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum PassengerType {
  ADULT
  CHILD
  YOUTH
  INFANT
}

enum NameTitle {
  MR
  MRS
  MS
  MISS
  MSTR
}

enum PaymentMethod {
  BANK_PAYMENT
  CARD
  INTERNATIONAL_CARD
  KLARNA
  CLEARPAY
  PAYPAL
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         Role       @default(AGENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  createdBookings Booking[] @relation("BookingCreatedBy")
  updatedBookings Booking[] @relation("BookingUpdatedBy")
}

model Booking {
  id                 String        @id @default(cuid())
  reference          String        @unique
  customerName       String
  phone              String
  email              String
  bookingType        BookingType
  journeyType        JourneyType
  cabinClass         CabinClass
  airline            String
  departureAirport   String
  destinationAirport String
  departureDate      DateTime      @db.Date
  returnDate         DateTime?     @db.Date
  totalSold          Decimal       @db.Decimal(12, 2)
  ticketCost         Decimal       @db.Decimal(12, 2)
  profit             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  notes              String?       @db.Text
  idempotencyKey     String?       @unique

  createdById String
  updatedById String
  createdBy   User      @relation("BookingCreatedBy", fields: [createdById], references: [id])
  updatedBy   User      @relation("BookingUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  travellers Traveller[]
  segments   FlightSegment[]

  @@index([customerName])
  @@index([phone])
  @@index([email])
  @@index([bookingType])
  @@index([createdAt])
}

model Traveller {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengerType PassengerType
  title         NameTitle
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime      @db.Date
  sortOrder     Int

  @@index([bookingId])
}

model FlightSegment {
  id                 String   @id @default(cuid())
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  segmentOrder       Int
  airline            String?
  departureAirport   String
  destinationAirport String
  departureDate      DateTime @db.Date

  @@index([bookingId])
}

model BookingCounter {
  year       Int @id
  lastNumber Int @default(0)
}